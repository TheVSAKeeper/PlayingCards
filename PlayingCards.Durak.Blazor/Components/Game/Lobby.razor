@inject TableHolder TableHolder
@implements IDisposable

<div class="table-main">
    <button class="btn btn-success" @onclick="CreateTable" disabled="@_busy">Создать стол</button>

    @if (_error != null || ExternalError != null)
    {
        <div class="lobby-error">@(_error ?? ExternalError)</div>
    }

    <div class="tables">
        @foreach (var t in _tables)
        {
            <TableCard Model="t" OnJoin="Join" Busy="_busy" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string PlayerSecret { get; set; } = default!;
    [Parameter, EditorRequired] public string PlayerName { get; set; } = default!;
    /// <summary>Ошибка авто-подсадки по ссылке-приглашению (стол полон / идёт игра / не найден).</summary>
    [Parameter] public string? ExternalError { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private TableModel[] _tables = [];
    private string? _error;
    private bool _busy;

    protected override void OnParametersSet() => ReloadTables();

    protected override void OnInitialized()
    {
        TableHolder.Changed += OnHolderChanged;
    }

    private void OnHolderChanged()
    {
        InvokeAsync(() =>
        {
            ReloadTables();
            StateHasChanged();
        });
    }

    private void ReloadTables() => _tables = TableViewBuilder.BuildLobby(TableHolder.GetTables());

    private Task CreateTable() => RunExclusive(() => TableHolder.CreateTable(PlayerSecret, PlayerName));

    private Task Join(Guid tableId) => RunExclusive(() => TableHolder.Join(tableId, PlayerSecret, PlayerName));

    private async Task RunExclusive(Action action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;

        try
        {
            action();
            _error = null;
            await OnChanged.InvokeAsync();
        }
        catch (BusinessException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        TableHolder.Changed -= OnHolderChanged;
    }
}
